# Copy to /opt/stacks/habit-tracker/.env.production on docker-home.
# Never commit the real production file.

POSTGRES_DB=habit_tracker
POSTGRES_USER=habit_tracker
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATA_DIR=/absolute/path/to/habit-tracker/postgres
POSTGRES_BACKUP_DIR=/absolute/path/to/habit-tracker/backups

# Optional. When omitted, backup files are never deleted automatically.
# BACKUP_RETENTION_DAYS=30

SESSION_SECRET=replace-with-at-least-32-random-characters
HOST_PORT=3011
COOKIE_SECURE=true
TRUST_PROXY=true

# Optional. Enable only after the HTTPS route exists.
# PUBLIC_HEALTH_URL=https://tracker.example.com/api/health
